generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id @default(uuid())
  email       String      @unique
  role        UserRole    @default(USER)
  avatar      String?
  bonusPoints Int         @default(0)
  password    String
  createdAt   DateTime    @default(now())
  fullName    String
  reviews     CarReview[] @relation("UserToReviews")
  rentals     Rental[]    @relation("UserToRentals")
}

model Car {
  id                String      @id @default(uuid())
  name              String
  brand             String
  model             String
  price             Int
  rating            Int
  isCurrentlyRented Boolean     @default(false)
  createdAt         DateTime    @default(now())
  images            String[]
  features          String[]
  carDetails        CarDetails? @relation("CarToDetails")
  reviews           CarReview[] @relation("CarToReviews")
  rentals           Rental[]    @relation("CarToRentals")
}

model Rental {
  id         String       @id @default(uuid())
  carId      String
  userId     String
  rentedFrom DateTime
  totalPrice Int
  notes      String?
  rentedTo   DateTime
  tel        String
  fullName   String
  status     RentalStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  car        Car          @relation("CarToRentals", fields: [carId], references: [id])
  user       User         @relation("UserToRentals", fields: [userId], references: [id])
}

model CarDetails {
  carId        String @id
  fuelType     String
  topSpeed     Int
  acceleration Float
  transmission String
  mileage      Int
  engineSize   Float
  enginePower  Int
  car          Car    @relation("CarToDetails", fields: [carId], references: [id])
}

model CarReview {
  id          String   @id @default(uuid())
  videoUrl    String
  carId       String
  reviewerId  String
  createdAt   DateTime @default(now())
  videoKey    String
  reviewedCar Car      @relation("CarToReviews", fields: [carId], references: [id])
  reviewer    User     @relation("UserToReviews", fields: [reviewerId], references: [id])
}

enum UserRole {
  USER
  ADMIN
}

enum RentalStatus {
  NOW_RENTED
  PENDING
  RETURNED
}
